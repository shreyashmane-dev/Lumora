# LUMORA Backend Configuration Example
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=generate-a-cryptographically-secure-secret-for-production
CORS_ORIGINS=["http://localhost:3000","https://lumora.ai","https://*.render.com","https://*.vercel.app"]

# Rate Limiting
RATE_LIMIT_ANONYMOUS_PER_MIN=15
RATE_LIMIT_ANONYMOUS_PER_DAY=100
RATE_LIMIT_API_KEY_PER_MIN=60
RATE_LIMIT_API_KEY_MONTHLY=10000

# Redis Rate Limiter (Optional - In-Memory Fallback Active if Empty)
REDIS_URL=

# Firebase Admin SDK (Optional - Local Developer Session Fallback Active if Empty)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
